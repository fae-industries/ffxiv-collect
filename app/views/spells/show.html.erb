<% title(@spell.name) %>
<% description(@spell.description.truncate(150)) %>
<% image(@spell.image_url) %>

<div class="row">
  <div class="col-12 col-lg-8 col-xl-6 offset-lg-2 offset-xl-3">
    <div class="card">
      <div class="card-header d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
          <div class="image-spell">
            <%= small_image(@spell) %>
          </div>
          <h5 class="card-title ml-3"><%= @spell.name %></h5>
        </div>
        <span class="badge badge-secondary"><%= t('spells.number') %> <%= @spell.order %></span>
      </div>
      <div class="card-body py-3">
        <div class="d-flex flex-column flex-info">
          <div class="d-flex flex-wrap">
            <div>
              <dt><%= t('spells.type') %></dt>
              <dd><%= @spell.type.name %></dd>
            </div>
            <div>
              <dt><%= spell_aspect(@spell) %></dt>
              <dd><%= @spell.aspect.name %></dd>
            </div>
            <div>
              <dt><%= t('spells.rank') %></dt>
              <dd><%= spell_rank(@spell) %></dd>
            </div>
            <%= render 'shared/ownership', collectable: @spell %>
            <div>
              <dt><%= t('patch') %></dt>
              <dd><%= @spell.patch %></dd>
            </div>
          </div>
          <dt><%= t('tooltip') %></dt>
          <dd><%= format_tooltip(@spell.tooltip) %></dd>
          <dt><%= t('description') %></dt>
          <dd><%= format_text_long(@spell.description) %></dd>
          <dt><%= t('spells.how_to_learn') %></dt>
          <dd class="mb-0"><%= sources(@spell, list: true) %></dd>
        </div>
      </div>
    </div>
  </div>
</div>
