<% title("Manage #{@model.name.titleize.pluralize}") %>

<div class="card">
  <div class="card-header">
    <div class="d-flex flex-wrap align-items-center">
      <h5 class="mb-2 mb-md-0 mr-auto">
        <%= link_to t('mod.manage_collectables'), mod_dashboard_path, class: 'unstyled' %> /
        <%= link_to t("#{@model.to_s.tableize}.title"), polymorphic_url([:mod, @model]), class: 'unstyled' %>
      </h5>
      <%= search_form_for(@q, url: polymorphic_url([:mod, @model]), class: 'form form-inline admin-search-form') do |f| %>
        <%= f.search_field "#{@model.current_locale_column(:name)}_cont", placeholder: t('name'), size: 30,
          class: 'form-control form-control-sm' %>
        <div class="form-group form-check">
          <%= check_box_tag :missing_patch, 1, @missing_patch %>
          <%= label_tag :missing_patch, t('mod.missing_patch') %>
        </div>
        <div class="form-group form-check">
          <%= check_box_tag :missing_source, 1, @missing_source %>
          <%= label_tag :missing_source, t('mod.missing_source') %>
        </div>
        <%= f.submit t('search'), class: 'btn btn-secondary btn-sm' %>
      <% end %>
    </div>
  </div>
  <div class="card-body card-table">
    <table class="table table-striped table-sm">
      <tr>
        <th></th> <!-- Image -->
        <th><%= t('name') %></th>
        <th><%= t('source') %></th>
        <th><%= t('patch') %></th>
        <th></th> <!-- Actions -->
      </tr>
      <% @collectables.each do |collectable| %>
        <tr>
          <td><%= small_image(collectable) %></td>
          <td>
            <%= collectable.name %>
            <%= gender_symbol(collectable.try(:gender)) %>
          </td>
          <td>
            <% if @model == SurveyRecord %>
              <%= collectable.solution %>
            <% else %>
              <%= sources(collectable) %>
            <% end %>
          </td>
          <td><%= collectable.patch %></td>
          <td class="text-center">
            <%= link_to fa_icon('pen'), polymorphic_url([:mod, collectable], action: :edit),
              class: 'btn btn-secondary btn-sm' %>
          </td>
        </tr>
      <% end %>
    </table>
  </div>
  <div class="card-footer d-flex justify-content-center mb-0">
    <%= will_paginate(@collectables) %>
  </div>
</div>
